{
  "name": "pi-caffeinated",
  "version": "0.1.2",
  "description": "Pi extension that toggles a cross-platform keep-awake process with a centered coffee break modal.",
  "type": "module",
  "license": "MIT",
  "author": "Tanishq Kancharla",
  "keywords": [
    "pi-package",
    "pi-extension",
    "caffeinate",
    "macos",
    "linux",
    "windows",
    "coffee"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanishqkancharla/pi-caffeinated.git"
  },
  "homepage": "https://github.com/tanishqkancharla/pi-caffeinated#readme",
  "bugs": {
    "url": "https://github.com/tanishqkancharla/pi-caffeinated/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "echo 'pi loads this package directly via jiti; no build step required'"
  },
  "files": [
    "README.md",
    "LICENSE",
    "caffeinate.ts"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "pi": {
    "extensions": [
      "./caffeinate.ts"
    ]
  }
}
